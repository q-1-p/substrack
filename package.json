{
  "$schema": "https://json.schemastore.org/package",
  "name": "substrack",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run --cwd apps/browser build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "bun tests/data/seed.ts",
    "db:studio": "drizzle-kit studio",
    "dev": "bun run --cwd apps/browser dev",
    "lint": "bunx @biomejs/biome check --write --unsafe ."
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@types/nodemailer": "^6.4.24",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "drizzle-seed": "^0.3.1",
    "nodemailer": "^10.0.6",
    "uuid": "^11.1.1"
  },
  "overrides": {
    "drizzle-orm": "^0.45.2",
    "postcss": "^8.5.25",
    "sharp": "^0.35.5",
    "esbuild": "^0.25.12",
    "postcss-selector-parser": "^7.1.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.20.1",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
